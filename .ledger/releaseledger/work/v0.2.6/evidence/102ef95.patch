+@dataclass(slots=True)
+class _TrieNode:
+    next: dict[str, _TrieNode]
+    token_id: int = -1
+    score: float = -math.inf
+
+    @classmethod
+    def create(cls) -> _TrieNode:
+        return cls(next={})
