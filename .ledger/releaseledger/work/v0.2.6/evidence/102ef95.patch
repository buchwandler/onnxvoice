+            "text_vocab_size": 8192,
+            "max_text_len": 2048,
+            "style_prefix_tokens": 2,
+            "ar_model_dim": 8,
+            "acoustic_dit_dim_head": 4,
+            "ar_blocks": 2,
+            "ar_heads": 2,
+            "ar_kv_heads": 1,
+        }
+    )
+    manifest["config"]["generation"].update({"style_tokens": 3, "prompt_tokens": 4})
+    manifest["config"]["vocoder"].update({"dim": 8, "num_layers": 2, "block_lookaheads": [3, 3]})
+    if include_prefix:
