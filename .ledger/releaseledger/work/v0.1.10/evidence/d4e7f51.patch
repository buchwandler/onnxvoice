+        artifacts=(Artifact("bundle_metadata", source.name, source.as_uri()),),
+        metadata={"canonical_catalog": True},
+    )
+    store = AssetStore(tmp_path / "cache")
+    with pytest.raises(IntegrityError, match="no positive size"):
+        store.install(item)
