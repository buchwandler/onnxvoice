+
+    prefill_session, decode_session, predictor_session = _sessions(config)
+    vocoder = _FakeVocoder()
+    adapter = cast(Any, Qwen3Adapter.__new__(Qwen3Adapter))
+    adapter.model_type = "base"
+    adapter.quality = "int4"
