+        }
+    }
+    source = tmp_path / "kokoro.json"
+    source.write_text(json.dumps(raw), encoding="utf-8")
+    item = CatalogClient(cache_dir=tmp_path / "cache", sources={"kokoro": str(source)}).resolve(
