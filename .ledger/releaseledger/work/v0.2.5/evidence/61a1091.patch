+def _require_inflect_safe_id(value: Any, label: str) -> str:
+    if not isinstance(value, str) or _INFLECT_SAFE_ID_RE.fullmatch(value) is None:
+        raise CatalogError(f"{label} is unsafe: {value!r}")
+    return value
+
