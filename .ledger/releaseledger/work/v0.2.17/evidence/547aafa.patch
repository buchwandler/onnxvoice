diff --git a/onnxvoice/systems/kokoro_language_router.py b/onnxvoice/systems/kokoro_language_router.py
new file mode 100644
index 0000000..a5dafeb
--- /dev/null
+++ b/onnxvoice/systems/kokoro_language_router.py
@@ -0,0 +1,156 @@
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping, Sequence
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from ..errors import CapabilityError, RuntimeContractError
+from ..inventory import language_base
+from ..runtime import OnnxSession
+from ..types import InferenceResult, Installation, RuntimeDiagnostic
+from .base import SystemAdapter
+from .kokoro_static import infer_static_kokoro
+
+LANGUAGE_ROUTER_LAYOUT = "language-router-onnx-v1"
+LANGUAGE_MODELS = {"en": "model_en", "de": "model_de"}
+
+
+class KokoroLanguageRouterRuntime(SystemAdapter):
+    """Static Kokoro inference routed to a graph by explicit language."""
+
+    system = "kokoro"
+
+    def __init__(
+        self,
+        installation: Installation,
+        *,
+        session_factory: Callable[[Path, str], Any] | None = None,
+        **kwargs: Any,
+    ) -> None:
+        super().__init__(installation, **kwargs)
+        self._session_factory = session_factory
+        self.language_models = self._parse_language_models()
+        self._sessions: dict[str, Any] = {}
+
+    def _parse_language_models(self) -> dict[str, str]:
+        runtime = self.installation.metadata.get("runtime")
+        if not isinstance(runtime, Mapping):
+            raise RuntimeContractError("Kokoro language-router runtime metadata must be an object")
+        configured = runtime.get("language_models")
+        if not isinstance(configured, Mapping):
+            raise RuntimeContractError("Kokoro language-router requires runtime.language_models")
+
+        models: dict[str, str] = {}
+        for raw_language, component in configured.items():
+            language = language_base(raw_language)
+            if not language or language in models:
+                raise RuntimeContractError(
+                    "Kokoro language_models has an invalid or duplicate language"
+                )
+            if not isinstance(component, str):
+                raise RuntimeContractError(
+                    f"Kokoro language_models entry for {language!r} must name a component"
+                )
+            models[language] = component
+        if models != LANGUAGE_MODELS:
+            raise RuntimeContractError(
+                "Kokoro language-router language_models must map en to model_en and de to model_de"
+            )
+
+        language_codes = runtime.get("language_codes")
+        if not isinstance(language_codes, (list, tuple)):
+            raise RuntimeContractError("Kokoro language-router requires runtime.language_codes")
+        normalized_codes = {language_base(code) for code in language_codes}
+        if not set(models) <= normalized_codes:
+            raise RuntimeContractError(
+                "Kokoro language-router language_codes must include en and de"
+            )
+        return models
+
+    def _component_path(self, language: str, component: str) -> Path:
+        candidates = self.installation.artifacts_for("model", component=component)
+        quality = self.installation.selected_quality
+        if quality is not None:
+            selected = tuple(artifact for artifact in candidates if artifact.quality == quality)
+            if selected:
+                candidates = selected
+            elif not (len(candidates) == 1 and candidates[0].quality is None):
+                candidates = ()
+        if len(candidates) != 1:
+            raise CapabilityError(
+                "Kokoro language-router requires exactly one model artifact for "
+                f"language={language!r}, component={component!r}, quality={quality!r}"
+            )
+        return candidates[0].path
+
+    def _session_for_language(self, language: str) -> Any:
+        if language not in self._sessions:
+            component = self.language_models[language]
+            path = self._component_path(language, component)
+            label = f"{language}:{component}"
+            if self._session_factory is None:
+                session = OnnxSession(
+                    path,
+                    component=label,
+                    providers=self.providers,
+                    provider_options=self.provider_options,
+                    session_options=self.session_options,
+                )
+            else:
+                session = self._session_factory(path, label)
+            self._sessions[language] = session
+        return self._sessions[language]
+
+    def infer(
+        self,
+        token_ids: Sequence[int],
+        *,
+        style: np.ndarray | Sequence[float] | None = None,
+        reference: Any | None = None,
+        language: str | None = None,
+        speed: float = 1.0,
+        seed: int = 1234,
+        **kwargs: Any,
+    ) -> InferenceResult:
+        del seed
+        if kwargs:
+            raise RuntimeContractError(
+                "Unsupported Kokoro language-router inference arguments: "
+                + ", ".join(sorted(kwargs))
+            )
+        if reference is not None:
+            raise RuntimeContractError(
+                "Reference conditioning is not supported by the Kokoro language-router layout"
+            )
+        if language is None or not isinstance(language, str) or not language.strip():
+            raise RuntimeContractError(
+                "A language is required for Kokoro language-router inference"
+            )
+        normalized_language = language_base(language)
+        if normalized_language not in self.language_models:
+            raise RuntimeContractError(
+                f"Unsupported Kokoro language-router language {language!r}; "
+                "supported languages are en and de"
+            )
+        if style is None:
+            raise RuntimeContractError("A model-ready Kokoro style must be provided")
+        session = self._session_for_language(normalized_language)
+        return infer_static_kokoro(
+            self.installation,
+            session,
+            token_ids,
+            style=style,
+            speed=speed,
+        )
+
+    def diagnostics(self) -> RuntimeDiagnostic:
+        base = super().diagnostics()
+        return RuntimeDiagnostic(
+            system=base.system,
+            ref=base.ref,
+            layout=base.layout,
+            sessions=base.sessions,
+            properties={"language_models": dict(self.language_models)},
+        )
diff --git a/onnxvoice/systems/kokoro_static.py b/onnxvoice/systems/kokoro_static.py
new file mode 100644
index 0000000..86a3401
--- /dev/null
+++ b/onnxvoice/systems/kokoro_static.py
@@ -0,0 +1,131 @@
+from __future__ import annotations
+
+from collections.abc import Sequence
+from typing import Any
+
+import numpy as np
+
+from ..errors import RuntimeContractError
+from ..types import InferenceResult, Installation, TensorSpec
+
+
+def infer_static_kokoro(
+    installation: Installation,
+    session: Any,
+    token_ids: Sequence[int],
+    *,
+    style: np.ndarray | Sequence[float] | None,
+    speed: float,
+) -> InferenceResult:
+    """Run the shared static Kokoro tokens, style, and speed graph contract."""
+    if style is None:
+        raise RuntimeContractError("A model-ready Kokoro style must be provided")
+
+    token_values = list(token_ids)
+    names = set(session.input_names)
+    token_name = "input_ids" if "input_ids" in names else "tokens"
+    style_name = "ref_s" if "ref_s" in names else "style"
+    token_spec = _input_spec(session, token_name)
+    token_dtype = _numpy_dtype(token_spec, default=np.int64)
+    _validate_token_limit(token_spec, len(token_values))
+    padded = np.asarray([[0, *token_values, 0]], dtype=token_dtype)
+
+    style_spec = _input_spec(session, style_name)
+    style_dtype = _numpy_dtype(style_spec, default=np.float32)
+    style_value = np.asarray(style, dtype=style_dtype)
+    if style_value.ndim == 1:
+        style_value = style_value[None, :]
+
+    inputs: dict[str, np.ndarray] = {token_name: padded, style_name: style_value}
+    if "speed" in names:
+        inputs["speed"] = np.asarray(
+            [speed], dtype=_numpy_dtype(_input_spec(session, "speed"), default=np.float32)
+        )
+    missing = {token_name, style_name} - names
+    if missing:
+        raise RuntimeContractError(
+            f"Kokoro model is missing expected inputs: {', '.join(sorted(missing))}"
+        )
+
+    outputs = session.run(inputs)
+    output_names = tuple(getattr(session, "output_names", ()))
+    if not outputs:
+        raise RuntimeContractError("Kokoro model returned no outputs")
+    if len(output_names) != len(outputs):
+        output_names = tuple(f"output_{index}" for index in range(len(outputs)))
+    named_outputs = {
+        name: np.asarray(value) for name, value in zip(output_names, outputs, strict=True)
+    }
+    audio_name = output_names[0]
+    audio = _canonical_audio(named_outputs[audio_name])
+    auxiliary = {name: value for name, value in named_outputs.items() if name != audio_name}
+    timings = _select_timings(installation, auxiliary)
+
+    return InferenceResult(
+        audio=audio,
+        sample_rate=int(installation.sample_rate or 24000),
+        timings=timings,
+        outputs=auxiliary,
+        metadata={"system": "kokoro", "speed": speed},
+    )
+
+
+def _input_spec(session: Any, name: str) -> TensorSpec | None:
+    for spec in getattr(session, "input_specs", ()):
+        if spec.name == name:
+            return spec
+    return None
+
+
+def _numpy_dtype(spec: TensorSpec | None, *, default: Any) -> np.dtype[Any]:
+    if spec is None:
+        return np.dtype(default)
+    dtype_name = spec.ort_type.lower()
+    for marker, dtype in (
+        ("int64", np.int64),
+        ("int32", np.int32),
+        ("int16", np.int16),
+        ("float16", np.float16),
+        ("float", np.float32),
+        ("double", np.float64),
+    ):
+        if marker in dtype_name:
+            return np.dtype(dtype)
+    raise RuntimeContractError(f"Unsupported Kokoro tensor type {spec.ort_type!r}")
+
+
+def _validate_token_limit(spec: TensorSpec | None, token_count: int) -> None:
+    if spec is None or not spec.shape:
+        return
+    maximum = spec.shape[-1]
+    if isinstance(maximum, int) and maximum > 0 and token_count + 2 > maximum:
+        raise RuntimeContractError(
+            f"Kokoro token sequence has {token_count} tokens, maximum is {maximum - 2}"
+        )
+
+
+def _select_timings(
+    installation: Installation, auxiliary: dict[str, np.ndarray]
+) -> np.ndarray | None:
+    declared = installation.timing_output
+    if declared and declared in auxiliary:
+        return auxiliary[declared]
+    for name in ("pred_dur", "duration", "durations", "timing", "timestamp"):
+        if name in auxiliary:
+            return auxiliary[name]
+    for prefix in ("duration", "timing", "timestamp"):
+        for name in sorted(auxiliary):
+            if name.lower().startswith(prefix):
+                return auxiliary[name]
+    return None
+
+
+def _canonical_audio(value: np.ndarray) -> np.ndarray:
+    audio = np.asarray(value)
+    audio = np.squeeze(audio)
+    if audio.ndim != 1:
+        if audio.ndim == 2 and 1 in audio.shape:
+            audio = audio.reshape(-1)
+        else:
+            raise RuntimeContractError("Kokoro audio output must be one-dimensional")
+    return audio.astype(np.float32, copy=False)
