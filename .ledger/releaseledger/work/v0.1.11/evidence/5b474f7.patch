+            (language, engine_code, key[1], key[2], key[0])
+            for key, (language, engine_code, _item) in pending.items()
+        ),
+    )
+    additions: list[dict[str, Any]] = []
+    for language, engine_code, asset_id, voice_id, system in ordered:
