+++ b/onnxvoice/systems/kitten2_decoder_reference.py
@@ -0,0 +1,65 @@
+"""Loading and validating deterministic decoder reference bundles."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+DECODER_REFERENCE_FORMAT = "kitten2-onnx-decoder-reference-v1"
+REQUIRED_ARRAYS = {
+    "conditioning_prompt_token",
+    "speaker_embedding",
+    "reference_tokens",
+    "conditioning_prompt_token_len",
+    "conditioning_prompt_feat",
+    "conditioning_embedding",
+    "speech_tokens",
+    "speech_token_lengths",
+    "flow_noise",
+    "flow_mel",
+    "mel2wav_input",
+    "vocoder_phase_noise",
+    "vocoder_sine_noise",
+    "mel2wav_waveform",
+    "waveform",
+}
+
+
+@dataclass(frozen=True)
+class DecoderReference:
+    arrays: dict[str, np.ndarray]
+    metadata: dict[str, Any]
+
+
+def load_decoder_reference(path: str | Path) -> DecoderReference:
+    path = Path(path)
+    metadata_path = path.with_suffix(".meta.json")
+    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
+    if metadata.get("format") != DECODER_REFERENCE_FORMAT:
+        raise ValueError(f"Unsupported decoder reference format in {metadata_path}")
+
+    with np.load(path, allow_pickle=False) as archive:
+        arrays = {name: archive[name] for name in archive.files}
+
+    if missing := REQUIRED_ARRAYS - arrays.keys():
+        raise ValueError(f"Decoder reference is missing arrays: {sorted(missing)}")
+    metadata_arrays = metadata.get("arrays")
+    if not isinstance(metadata_arrays, dict):
+        raise TypeError("Decoder reference metadata has no array contract")
+    if metadata_arrays.keys() != arrays.keys():
+        raise ValueError("Decoder reference array names do not match the metadata")
+    for name, array in arrays.items():
+        expected = metadata_arrays[name]
+        if expected.get("shape") != list(array.shape):
+            raise ValueError(f"Decoder reference shape mismatch for {name!r}")
+        if expected.get("dtype") != str(array.dtype):
+            raise ValueError(f"Decoder reference dtype mismatch for {name!r}")
+
+    if not np.array_equal(arrays["flow_mel"], arrays["mel2wav_input"]):
+        raise ValueError("The captured mel2wav input differs from the flow output mel")
+    return DecoderReference(arrays=arrays, metadata=metadata)
+
diff --git a/onnxvoice/systems/kitten2_frontend.py b/onnxvoice/systems/kitten2_frontend.py
new file mode 100644
index 0000000..75507d8
--- /dev/null
+++ b/onnxvoice/systems/kitten2_frontend.py
@@ -0,0 +1,134 @@
+"""Prompt assembly for reference-conditioned KittenTTS 2 generation."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from ..errors import OptionalDependencyError, RuntimeContractError
+from .kitten2_decoder_reference import load_decoder_reference
+from .kitten2_tokens import TokenMap
+
+
+def build_reference_prefix(
+    token_map: TokenMap,
+    reference_text_ids: Sequence[int],
+    reference_audio_tokens: Sequence[int],
+) -> list[int]:
+    """Build the in-context reference transcript and 0-based S3 token prefix."""
+    audio_ids = [token_map.audio_id_base + token for token in reference_audio_tokens]
+    if token_map.uses_reference_role_tokens:
+        return [
+            token_map.start_id,
+            token_map.reference_text_start_id,
+            *reference_text_ids,
+            token_map.reference_text_end_id,
+            token_map.reference_speech_start_id,
+            *audio_ids,
+            token_map.reference_speech_end_id,
+        ]
+    return [
+        token_map.start_id,
+        token_map.text_start_id,
+        *reference_text_ids,
+        token_map.speech_start_id,
+        *audio_ids,
+        token_map.speech_end_id,
+    ]
+
+
+def build_generation_prompt(
+    token_map: TokenMap,
+    target_text_ids: Sequence[int],
+    reference_prefix: Sequence[int] | None = None,
+    emotion_ids: Sequence[int] | None = None,
+) -> list[int]:
+    """Build the target segment, optionally preceded by a reference prefix."""
+    head = list(reference_prefix) if reference_prefix else [token_map.start_id]
+    final_marker = [token_map.final_seg_id] if token_map.final_seg_id else []
+    return [
+        *head,
+        *(emotion_ids or []),
+        token_map.text_start_id,
+        *target_text_ids,
+        *final_marker,
+        token_map.speech_start_id,
+    ]
+
+
+@dataclass(frozen=True)
+class PreparedVoice:
+    speaker_embedding: np.ndarray
+    reference_prefix: list[int]
+    conditioning: dict[str, np.ndarray]
+
+
+class Kitten2Frontend:
+    def __init__(self, root: str | Path, manifest: dict[str, Any], token_map: TokenMap) -> None:
+        self.root = Path(root)
+        self.manifest = manifest
+        self.token_map = token_map
+        self._tokenizer: Any | None = None
+        self._normalize_text: Any | None = None
+
+    def _load_tokenizer(self) -> None:
+        if self._tokenizer is not None:
+            return
+        try:
+            import kitten_text_processing
+            from transformers import AutoTokenizer
+        except ImportError as exc:
+            raise OptionalDependencyError(
+                "Kitten2 text processing requires onnxvoice[kitten2]."
+            ) from exc
+        self._normalize_text = kitten_text_processing.normalize_text
+        tokenizer_path = self.root / self.manifest["tokenizer"]
+        self._tokenizer = AutoTokenizer.from_pretrained(
+            str(tokenizer_path), local_files_only=True
+        )
+
+    def encode_text(self, text: str) -> tuple[str, list[int]]:
+        self._load_tokenizer()
+        normalize_text = self._normalize_text
+        tokenizer = self._tokenizer
+        assert normalize_text is not None and tokenizer is not None
+        normalized = normalize_text(text).strip()
+        if not normalized:
+            raise ValueError("text must not be empty after normalization")
+        return normalized, tokenizer.encode(normalized, add_special_tokens=False)
+
+    def prepare_voice(self, voice: str) -> PreparedVoice:
+        voices = self.manifest["voices"]
+        if voice not in voices:
+            raise ValueError(f"Unknown voice {voice!r}; available voices: {', '.join(sorted(voices))}")
+        self._load_tokenizer()
+        tokenizer = self._tokenizer
+        assert tokenizer is not None
+        reference = load_decoder_reference(self.root / voices[voice])
+        transcript = reference.metadata.get("reference_transcript")
+        if not isinstance(transcript, str):
+            raise RuntimeContractError(f"Voice {voice!r} is missing its reference transcript")
+        reference_text_ids = tokenizer.encode(transcript.strip(), add_special_tokens=False)
+        reference_prefix = build_reference_prefix(
+            self.token_map,
+            reference_text_ids,
+            reference.arrays["reference_tokens"].tolist(),
+        )
+        conditioning = {
+            key: reference.arrays[key]
+            for key in (
+                "conditioning_prompt_token",
+                "conditioning_prompt_token_len",
+                "conditioning_prompt_feat",
+                "conditioning_embedding",
+            )
+        }
+        return PreparedVoice(
+            speaker_embedding=np.asarray(reference.arrays["speaker_embedding"], dtype=np.float32),
+            reference_prefix=reference_prefix,
+            conditioning=conditioning,
+        )
diff --git a/onnxvoice/systems/kitten2_generation.py b/onnxvoice/systems/kitten2_generation.py
new file mode 100644
index 0000000..48d38ea
--- /dev/null
+++ b/onnxvoice/systems/kitten2_generation.py
@@ -0,0 +1,235 @@
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from ..runtime import OnnxSession
+from .kitten2_sampling import SamplingSettings, is_eos_token, sample
+from .kitten2_tokens import TokenMap
+
+
+@dataclass(frozen=True)
+class GenerationResult:
+    raw_ids: list[int]
+    s3_ids: list[int]
+
+
+class Kitten2LanguageModel:
+    """Drive the exported Qwen3 LM with explicit embeddings and KV cache.
+
+    This class handles speaker projection and LM token generation. It does not yet
+    reproduce the S3 waveform decoder.
+    """
+
+    def __init__(
+        self,
+        lm_session: OnnxSession,
+        speaker_session: OnnxSession,
+        metadata: Mapping[str, Any],
+        embeddings_path: str | Path,
+    ) -> None:
+        self.session = lm_session
+        self.speaker_session = speaker_session
+        self.meta = dict(metadata)
+        runtime_profile = self.meta.get("runtime_profile")
+        io_dtype = self.meta.get("io_dtype")
+        if runtime_profile is None or io_dtype is None:
+            raise ValueError("LM metadata must declare runtime_profile and io_dtype")
+        if io_dtype == "bfloat16":
+            raise NotImplementedError(
+                "bfloat16 LM I/O requires ONNX Runtime I/O binding; NumPy session.run is unsupported"
+            )
+        if io_dtype not in {"float32", "float16"}:
+            raise ValueError(f"Unsupported LM I/O dtype: {io_dtype!r}")
+        self.input_mode = self.meta.get("input_mode", "inputs_embeds")
+        if self.input_mode == "inputs_embeds":
+            self.embeddings = np.load(embeddings_path, mmap_mode="r", allow_pickle=False)
+            self.embedding_storage_dtype = self.meta.get(
+                "embedding_storage_dtype", str(self.embeddings.dtype)
+            )
+            if self.embedding_storage_dtype == "bfloat16-u16":
+                if self.embeddings.dtype != np.uint16:
+                    raise ValueError("bfloat16-u16 embedding storage must use uint16")
+            elif str(self.embeddings.dtype) != self.embedding_storage_dtype:
+                raise ValueError("Embedding array dtype differs from LM metadata")
+        elif self.input_mode == "input_ids":
+            if self.meta.get("embedding_file") is not None:
+                raise ValueError("input_ids LM metadata must not reference a separate embedding table")
+            self.embeddings = None
+            self.embedding_storage_dtype = None
+        else:
+            raise ValueError(f"Unsupported LM input mode: {self.input_mode!r}")
+        runtime_memory_profile = self.meta.get("runtime_memory_profile", "default")
+        if runtime_memory_profile not in {"default", "low-memory-exact-ternary"}:
+            raise ValueError(f"Unsupported runtime memory profile: {runtime_memory_profile!r}")
+        self.layers = int(self.meta["num_hidden_layers"])
+        self.kv_heads = int(self.meta["num_key_value_heads"])
+        self.head_dim = int(self.meta["head_dim"])
+        graph_inputs = {item.name: item.ort_type for item in self.session.input_specs}
+        expected_type = {"float32": "tensor(float)", "float16": "tensor(float16)"}[io_dtype]
+        if self.input_mode == "inputs_embeds":
+            graph_input_type = graph_inputs.get("inputs_embeds")
+            if graph_input_type != expected_type:
+                raise ValueError(
+                    f"LM metadata io_dtype {io_dtype!r} does not match inputs_embeds type "
+                    f"{graph_input_type!r}"
+                )
+        else:
+            if graph_inputs.get("input_ids") != "tensor(int64)":
+                raise ValueError("input_ids LM graph must accept int64 token IDs")
+            if graph_inputs.get("speaker_hidden") != expected_type:
+                raise ValueError("LM metadata io_dtype does not match speaker_hidden graph input")
+        self.model_numpy_dtype = {"float32": np.float32, "float16": np.float16}[io_dtype]
+
+    def _empty_cache(self) -> dict[str, np.ndarray]:
+        shape = (1, self.kv_heads, 0, self.head_dim)
+        return {
+            name: np.zeros(shape, dtype=self.model_numpy_dtype)
+            for i in range(self.layers)
+            for name in (f"past_key_{i}", f"past_value_{i}")
+        }
+
+    def _project_speaker(self, speaker_embedding: np.ndarray) -> np.ndarray:
+        speaker_embedding = np.asarray(speaker_embedding, dtype=np.float32)
+        if speaker_embedding.ndim == 1:
+            speaker_embedding = speaker_embedding[None, :]
+        return self.speaker_session.run({"speaker_embedding": speaker_embedding})[0]
+    def _embed(
+        self,
+        token_ids: np.ndarray,
+        *,
+        speaker_embedding: np.ndarray | None = None,
+        prefill: bool,
+    ) -> np.ndarray:
+        token_ids = np.asarray(token_ids, dtype=np.int64)
+        if self.embedding_storage_dtype == "bfloat16-u16":
+            bits = np.asarray(self.embeddings[token_ids], dtype=np.uint32) << 16
+            values = bits.view(np.float32).astype(self.model_numpy_dtype)
+        else:
+            values = np.asarray(self.embeddings[token_ids], dtype=self.model_numpy_dtype)
+        if prefill and speaker_embedding is not None:
+            speaker_hidden = self._project_speaker(speaker_embedding)
+            values = values.copy()
+            values[0, 0, :] = speaker_hidden[0].astype(values.dtype, copy=False)
+        return values
+
+    def step(
+        self,
+        token_ids: np.ndarray,
+        *,
+        past: dict[str, np.ndarray] | None = None,
+        speaker_embedding: np.ndarray | None = None,
+        position: int | None = None,
+    ) -> tuple[np.ndarray, dict[str, np.ndarray]]:
+        """Run prefill or one cached decode chunk.
+
+        ``token_ids`` must have shape ``[1, S]``. If ``past`` is omitted this is
+        treated as prefill and an empty cache is supplied.
+        """
+        token_ids = np.asarray(token_ids, dtype=np.int64)
+        if token_ids.ndim != 2 or token_ids.shape[0] != 1:
+            raise ValueError("token_ids must have shape [1, S]")
+
+        is_prefill = past is None
+        past = self._empty_cache() if past is None else past
+        past_len = next(iter(past.values())).shape[2]
+        start = past_len if position is None else int(position)
+
+        attention_mask = np.ones((1, past_len + token_ids.shape[1]), dtype=np.int64)
+        position_ids = np.arange(
+            start,
+            start + token_ids.shape[1],
+            dtype=np.int64,
+        )[None, :]
+        inputs = {
+            "attention_mask": attention_mask,
+            "position_ids": position_ids,
+            **past,
+        }
+        if self.input_mode == "inputs_embeds":
+            inputs["inputs_embeds"] = self._embed(
+                token_ids,
+                speaker_embedding=speaker_embedding,
+                prefill=is_prefill,
+            )
+        else:
+            speaker_hidden = np.zeros(
+                (1, int(self.meta["hidden_size"])), dtype=self.model_numpy_dtype
+            )
+            if is_prefill and speaker_embedding is not None:
+                speaker_hidden = self._project_speaker(speaker_embedding).astype(
+                    self.model_numpy_dtype, copy=False
+                )
+            inputs["input_ids"] = token_ids
+            inputs["speaker_hidden"] = speaker_hidden
+        outputs = self.session.run(inputs)
+        logits = outputs[0]
+        new_past: dict[str, np.ndarray] = {}
+        for i in range(self.layers):
+            new_past[f"past_key_{i}"] = outputs[1 + 2 * i]
+            new_past[f"past_value_{i}"] = outputs[2 + 2 * i]
+        return logits, new_past
+
+    def generate(
+        self,
+        prompt_ids: list[int],
+        *,
+        token_map: TokenMap,
+        max_new_tokens: int,
+        speaker_embedding: np.ndarray | None = None,
+        settings: SamplingSettings | None = None,
+        seed: int | None = None,
+        stop_ids: set[int] | None = None,
+        logits_callback: Callable[[int, np.ndarray], None] | None = None,
+    ) -> GenerationResult:
+        """Generate raw LM IDs and their in-range, zero-based S3 counterparts."""
+        if not prompt_ids:
+            raise ValueError("prompt_ids may not be empty")
+        if max_new_tokens < 0:
+            raise ValueError("max_new_tokens must be non-negative")
+        if max_new_tokens == 0:
+            return GenerationResult(raw_ids=[], s3_ids=[])
+
+        settings = settings or SamplingSettings()
+        rng = np.random.default_rng(seed)
+        history = [int(token) for token in prompt_ids]
+        prompt_length = len(history)
+        logits, past = self.step(
+            np.asarray([history], dtype=np.int64),
+            speaker_embedding=speaker_embedding,
+        )
+        raw_ids: list[int] = []
+
+        for step_index in range(max_new_tokens):
+            if logits_callback is not None:
+                logits_callback(step_index, np.asarray(logits[0]).copy())
+            token = sample(
+                logits[0],
+                history,
+                token_map,
+                settings,
+                float(rng.random()),
+                prompt_length=prompt_length,
+            )
+            raw_ids.append(token)
+            should_stop = is_eos_token(token, token_map) if stop_ids is None else token in stop_ids
+            if should_stop:
+                break
+            history.append(token)
+            logits, past = self.step(
+                np.asarray([[token]], dtype=np.int64),
+                past=past,
+            )
+
+        s3_ids = [
+            token - token_map.audio_id_base
+            for token in raw_ids
+            if token_map.audio_id_base <= token < token_map.audio_id_end
+        ]
+        return GenerationResult(raw_ids=raw_ids, s3_ids=s3_ids)
+
+
diff --git a/onnxvoice/systems/kitten2_sampling.py b/onnxvoice/systems/kitten2_sampling.py
new file mode 100644
index 0000000..c83b21e
--- /dev/null
+++ b/onnxvoice/systems/kitten2_sampling.py
@@ -0,0 +1,214 @@
+"""KittenTTS 2 decode-time logit processing and controlled sampling."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+
+import numpy as np
+
+from .kitten2_tokens import TokenMap
+
+SILENCE_TOKEN = 4299
+
+
+@dataclass(frozen=True)
+class SamplingSettings:
+    temperature: float = 0.8
+    top_k: int = 50
+    top_p: float = 0.8
+    min_p: float = 0.0
+    repetition_penalty: float = 1.1
+    repetition_window: int | None = 50
+    token_run_penalty: float = 1.3
+    token_run_grace: int = 10
+
+    def __post_init__(self) -> None:
+        if self.temperature <= 0:
+            raise ValueError("temperature must be greater than zero")
+        if self.top_k < 0:
+            raise ValueError("top_k must be non-negative")
+        if not 0 <= self.top_p <= 1:
+            raise ValueError("top_p must be between zero and one")
+        if not 0 <= self.min_p <= 1:
+            raise ValueError("min_p must be between zero and one")
+        if self.repetition_penalty <= 0:
+            raise ValueError("repetition_penalty must be greater than zero")
+        if self.repetition_window is not None and self.repetition_window < 0:
+            raise ValueError("repetition_window must be non-negative")
+        if self.token_run_penalty < 0:
+            raise ValueError("token_run_penalty must be non-negative")
+        if self.token_run_grace < 1:
+            raise ValueError("token_run_grace must be positive")
+
+
+def sampling_settings_from_config(
+    config: Mapping[str, object], preset: str | None = None
+) -> SamplingSettings:
+    """Resolve the checkpoint's decode preset and generation repetition window."""
+    preset_name = preset or config.get("default_preset")
+    presets = config.get("decode_presets")
+    if not isinstance(preset_name, str):
+        raise TypeError("default_preset must be a string")
+    if not isinstance(presets, Mapping):
+        raise TypeError("model config decode_presets must be an object")
+    values = presets.get(preset_name)
+    if values is None:
+        raise ValueError(f"unknown decode preset {preset_name!r}")
+    if not isinstance(values, Mapping):
+        raise TypeError(f"decode preset {preset_name!r} must be an object")
+    generation = config.get("generation", {})
+    if not isinstance(generation, Mapping):
+        raise TypeError("model config generation settings must be an object")
+    return SamplingSettings(
+        temperature=float(values["temperature"]),
+        top_k=int(values["top_k"]),
+        top_p=float(values["top_p"]),
+        min_p=float(values.get("min_p", 0.0)),
+        repetition_window=int(generation.get("repetition_window", 50)),
+    )
+
+
+def _softmax(scores: np.ndarray) -> np.ndarray:
+    if np.isnan(scores).any() or np.isposinf(scores).any():
+        raise ValueError("logits must not contain NaN or positive infinity")
+    maximum = np.max(scores)
+    if not np.isfinite(maximum):
+        raise ValueError("at least one logit must remain unfiltered")
+    probabilities = np.exp(scores - maximum)
+    probabilities /= probabilities.sum()
+    return probabilities
+
+
+def _apply_token_run_penalty(
+    scores: np.ndarray,
+    history: np.ndarray,
+    token_map: TokenMap,
+    settings: SamplingSettings,
+) -> None:
+    if not history.size or not settings.token_run_penalty:
+        return
+    token_id = int(history[-1])
+    if not token_map.audio_id_base <= token_id < token_map.audio_id_end:
+        return
+    run_length = 1
+    for previous_id in history[-2::-1]:
+        if previous_id != token_id:
+            break
+        run_length += 1
+    if run_length >= settings.token_run_grace:
+        escalation = run_length - settings.token_run_grace + 1
+        scores[token_id] -= escalation * settings.token_run_penalty
+
+
+def _apply_repetition_penalty(
+    scores: np.ndarray,
+    history: np.ndarray,
+    token_map: TokenMap,
+    settings: SamplingSettings,
+    prompt_length: int,
+) -> None:
+    if not history.size or settings.repetition_penalty == 1.0:
+        return
+    if settings.repetition_window:
+        start = max(prompt_length, history.size - settings.repetition_window)
+        history = history[start:]
+    exempt = {
+        token_map.speech_end_id,
+        token_map.stop_id,
+        token_map.audio_id_base + SILENCE_TOKEN,
+    }
+    for token_id in {int(value) for value in history}:
+        if token_id in exempt:
+            continue
+        if token_id < 0 or token_id >= scores.size:
+            raise ValueError(f"history token {token_id} is outside the logits vocabulary")
+        score = scores[token_id]
+        scores[token_id] = (
+            score * settings.repetition_penalty
+            if score < 0
+            else score / settings.repetition_penalty
+        )
+
+
+def _apply_top_k(scores: np.ndarray, top_k: int) -> None:
+    if not top_k or top_k >= scores.size:
+        return
+    threshold = np.partition(scores, -top_k)[-top_k]
+    scores[scores < threshold] = -np.inf
+
+
+def _apply_top_p(scores: np.ndarray, top_p: float) -> None:
+    if top_p == 1.0:
+        return
+    sorted_indices = np.argsort(scores, kind="stable")
+    sorted_scores = scores[sorted_indices]
+    cumulative_probabilities = np.cumsum(_softmax(sorted_scores))
+    remove = cumulative_probabilities <= 1.0 - top_p
+    remove[-1] = False
+    scores[sorted_indices[remove]] = -np.inf
+
+
+def _apply_min_p(scores: np.ndarray, min_p: float) -> None:
+    if min_p == 0.0:
+        return
+    probabilities = _softmax(scores)
+    threshold = min_p * probabilities.max()
+    scores[probabilities < threshold] = -np.inf
+
+
+def process_logits(
+    logits: np.ndarray,
+    history: Sequence[int],
+    token_map: TokenMap,
+    settings: SamplingSettings,
+    *,
+    prompt_length: int = 0,
+) -> np.ndarray:
+    """Apply Kitten's ordered token-run, repetition, temperature, and truncation processors."""
+    scores = np.asarray(logits, dtype=np.float64).copy()
+    if scores.ndim != 1 or not scores.size:
+        raise ValueError("logits must be a non-empty one-dimensional array")
+    history_ids = np.asarray(history, dtype=np.int64).reshape(-1)
+    if prompt_length < 0 or prompt_length > history_ids.size:
+        raise ValueError("prompt_length must be within the history")
+
+    _apply_token_run_penalty(scores, history_ids, token_map, settings)
+    _apply_repetition_penalty(scores, history_ids, token_map, settings, prompt_length)
+    if settings.temperature != 1.0:
+        scores /= settings.temperature
+    _apply_top_k(scores, settings.top_k)
+    _apply_top_p(scores, settings.top_p)
+    _apply_min_p(scores, settings.min_p)
+    return scores
+
+
+def sample(
+    logits: np.ndarray,
+    history: Sequence[int],
+    token_map: TokenMap,
+    settings: SamplingSettings,
+    u: float,
+    *,
+    prompt_length: int = 0,
+) -> int:
+    """Sample one token using a controlled uniform variate in ``[0, 1)``."""
+    if not 0.0 <= u < 1.0:
+        raise ValueError("u must be in [0, 1)")
+    probabilities = _softmax(
+        process_logits(
+            logits,
+            history,
+            token_map,
+            settings,
+            prompt_length=prompt_length,
+        )
+    )
+    cumulative = np.cumsum(probabilities)
+    cumulative[-1] = 1.0
+    return int(np.searchsorted(cumulative, u, side="right"))
+
+
+def is_eos_token(token_id: int, token_map: TokenMap) -> bool:
+    """Return whether a generated LM token terminates Kitten speech generation."""
+    return int(token_id) in {token_map.speech_end_id, token_map.stop_id}
